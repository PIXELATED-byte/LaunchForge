{
  "name": "launchforge-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "oauth:check": "node scripts/oauth-check.js",
    "pretest": "node -e \"require('fs').existsSync('test')&&require('fs').readdirSync('test').some(f=>f.endsWith('.test.js'))||(console.error('ERROR: test/ folder or *.test.js files are missing'),process.exit(1))\"",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.0"
  }
}
