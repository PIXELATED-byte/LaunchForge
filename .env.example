# Copy this file to ".env" and fill in YOUR values. Never commit .env (it is in .gitignore).

# --- Gemini (AI editor) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
PORT=3000
# On Render set NODE_ENV=production. That turns on Secure + SameSite=None cookies and disables localhost CORS.
NODE_ENV=development
# Sites allowed to call this backend from a browser. Exact origins only (scheme + host, no path, no trailing slash). Never "*".
ALLOWED_ORIGINS=https://pixelated-byte.github.io
RATE_LIMIT_PER_MINUTE=10
MAX_HTML_CHARS=150000
AI_TIMEOUT_MS=100000

# --- Database (Neon Postgres) ---
# The POOLED connection string. Leave empty to run without server storage.
DATABASE_URL=
# Optional: a DIRECT (non-pooled) string used only by `npm run migrate`.
MIGRATION_DATABASE_URL=
# Local development only: apply pending migrations automatically at startup. Ignored on Render / in production.
AUTO_MIGRATE=false

# --- Accounts and sessions ---
# REQUIRED in production: a long random string (32+ characters) used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=7
# Defaults: "none" in production (GitHub Pages and Render are different sites), "lax" locally.
# Use "lax" only if the page is served from the SAME site as the API (for example the Render URL itself).
COOKIE_SAMESITE=

# --- Free-tier guards (optional) ---
MAX_PROJECTS_PER_OWNER=50
MAX_TOTAL_PROJECTS=1000
WRITE_RATE_PER_MINUTE=120

# --- Tests only (optional) ---
# A THROWAWAY database such as a Neon "dev" branch. Never production. Tests refuse to run if it matches DATABASE_URL.
# TEST_DATABASE_URL=
