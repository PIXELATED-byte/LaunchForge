# Copy this file to ".env" and fill in YOUR values. Never commit .env (it is in .gitignore).

# --- Gemini (AI editor) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server ---
PORT=3000
# Sites allowed to call this backend from a browser (no trailing slash or path)
ALLOWED_ORIGINS=https://pixelated-byte.github.io
RATE_LIMIT_PER_MINUTE=10
MAX_HTML_CHARS=150000
AI_TIMEOUT_MS=100000

# --- Project storage (Neon Postgres) ---
# Paste the POOLED connection string from the Neon dashboard. Leave empty to run without server storage
# (the app then saves projects in the browser only, and the AI editor still works).
DATABASE_URL=
# Free-tier guards (optional)
MAX_PROJECTS_PER_OWNER=50
MAX_TOTAL_PROJECTS=1000
WRITE_RATE_PER_MINUTE=120

# --- Tests only (optional) ---
# A THROWAWAY database such as a Neon "dev" branch. Never point this at production data.
# TEST_DATABASE_URL=
