# Copy this file to ".env" and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# Comma-separated sites allowed to call the backend from a browser (needed when the frontend is on GitHub Pages)
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
RATE_LIMIT_PER_MINUTE=10
MAX_HTML_CHARS=150000
AI_TIMEOUT_MS=100000
